{
  "appId": "com.zorpill.desktop",
  "productName": "Zorpill",
  "directories": {
    "output": "release"
  },
  "files": ["dist-electron", "dist-react"],
  "icon": "./desktop-icon.ico",
  "mac": {
    "target": ["dmg"]
  },
  "linux": {
    "target": ["AppImage"],
    "category": "Utility"
  },
  "win": {
    "icon": "./desktop-icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "msi",
        "arch": ["x64"]
      }
    ]
  }
}
